{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/",
    "baseUrl": "./src",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@assets/*": ["assets/*"],
      "@constants/*": ["CONSTANTS/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}